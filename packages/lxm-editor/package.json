{
  "name": "@liuxianmao/lxm-editor",
  "version": "1.0.0",
  "description": "六线猫曲谱文档、编辑命令、布局与播放计划的 JavaScript Core",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "files": ["dist", "README.md", "docs/api-v1.md", "demo"],
  "scripts": {
    "assets:build": "node ./scripts/standardize-svg-assets.mjs",
    "dev": "node ./scripts/build.mjs --watch",
    "build": "node ./scripts/build.mjs",
    "prepack": "npm run build",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@liuxianmao/eslint-config": "workspace:*",
    "@liuxianmao/tsconfig": "workspace:*",
    "@types/node": "^25.9.3",
    "eslint": "^9.0.0",
    "svgo": "^3.3.2",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
