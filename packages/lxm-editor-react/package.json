{
  "name": "@liuxianmao/lxm-editor-react",
  "version": "1.0.0",
  "description": "六线猫六线谱编辑工作区的 React 组件与宿主会话",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    },
    "./page.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./page.css"
    }
  },
  "files": ["dist", "page.css", "README.md", "Bravura-OFL.txt"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && vite build --watch --emptyOutDir false",
    "build": "vite build && tsc -p tsconfig.build.json",
    "lint": "eslint src vite.config.ts",
    "prepack": "pnpm run build",
    "type-check": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@liuxianmao/lxm-editor": "workspace:1.0.0",
    "antd": "^6.4.4",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@liuxianmao/eslint-config": "workspace:*",
    "@liuxianmao/tsconfig": "workspace:*",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.89.2",
    "typescript": "^6.0.3",
    "vite": "^7.3.5"
  }
}
