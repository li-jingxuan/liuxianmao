APP_ENV=development
API_HOST=0.0.0.0
API_PORT=3112
API_RELOAD=true
DATABASE_URL=postgresql+psycopg://pindou:<url-encoded-password>@127.0.0.1:5432/pindou
KEY_ISSUER_API_KEY=<high-entropy-admin-secret>
API_KEY_HASH_PEPPER=<different-high-entropy-secret>
IMAGE_ENHANCER=passthrough
# IMAGE_ENHANCER=seedream
# passthrough 只用于本地 keep/simplify 调试；Solid 和生产必须使用 Seedream。
# Solid 在 true/false 两种配置下都先让 Seedream 生成动态键色图。
ENABLE_ONNX_MATTING=true
# ARK_DOUBAO_API_KEY=<secret>
ARK_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-lite-260128
ARK_DOUBAO_IMAGE_SIZE=2K
ARK_DOUBAO_RESPONSE_FORMAT=b64_json
ARK_DOUBAO_WATERMARK=false
ARK_DOUBAO_CONNECT_TIMEOUT_SECONDS=5
ARK_DOUBAO_READ_TIMEOUT_SECONDS=90
ARK_DOUBAO_WRITE_TIMEOUT_SECONDS=15
ARK_DOUBAO_POOL_TIMEOUT_SECONDS=5
ARK_DOUBAO_MAX_CONCURRENCY=2
ARK_DOUBAO_QUEUE_TIMEOUT_SECONDS=3
ARK_DOUBAO_MAX_RESPONSE_BYTES=31457280
SEEDREAM_INPUT_MAX_EDGE=2048
SEEDREAM_OUTPUT_MAX_PIXELS=20000000
FOREGROUND_MASK_ADAPTER=onnx
# 默认完整 U²-Net；切为 u2netp 可降低资源占用和推理延迟。
FOREGROUND_MODEL_VARIANT=u2netp # u2net
FOREGROUND_MASK_MAX_CONCURRENCY=1
FOREGROUND_MASK_QUEUE_TIMEOUT_SECONDS=3
FOREGROUND_ONNX_INTRA_OP_THREADS=2
FOREGROUND_ONNX_ALLOW_SPINNING=false
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PIXELS=25000000
MIN_GRID_SIZE=8
MAX_GRID_SIZE=156
DEFAULT_COLOR_SET_SIZE=264
# MARD_COLOR_CHART_PATH=/absolute/path/to/docs/MARD_色卡.json
# IMAGE_BACKUP_DIR=/absolute/path/to/assets/images
# 通用结构化事件日志，默认为仓库根目录 log/
# EVENT_LOG_DIR=/absolute/path/to/log
# 管理员交付图独立目录及短期保留策略（默认 7 天）
# IMAGE_DELIVERY_DIR=/absolute/path/to/image-deliveries
IMAGE_DELIVERY_TTL_SECONDS=604800
IMAGE_DELIVERY_MAX_BYTES=31457280
IMAGE_DELIVERY_MAX_PIXELS=50000000
IMAGE_DELIVERY_CLEANUP_INTERVAL_SECONDS=3600
