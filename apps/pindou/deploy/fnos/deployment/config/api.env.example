# API 运行配置格式示例；安装向导会自动生成真实 api.env。
# 已有应用请编辑原文件，不要用本模板覆盖。
# 双引号值；字面 $ 写成 $$，反斜杠写成 \\；不要 source 此文件。
# 数据库密码须与 postgres.env 一致，并在 DATABASE_URL 中进行 URL 编码。
DATABASE_URL="postgresql+psycopg://pindou:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/pindou"
# 本部署的签发管理密钥，对应 X-Admin-API-Key；不是方舟密钥或消费密钥。
KEY_ISSUER_API_KEY="REPLACE_WITH_GENERATED_MANAGEMENT_KEY"
# 已有数据库的 Pepper 必须保留，否则原访问密钥将失效。
API_KEY_HASH_PEPPER="REPLACE_WITH_GENERATED_HASH_PEPPER"
APP_ENV="production"
IMAGE_ENHANCER="seedream"
ARK_DOUBAO_API_KEY="REPLACE_WITH_YOUR_ARK_API_KEY"
ARK_DOUBAO_MAX_CONCURRENCY="1"
IMAGE_DELIVERY_TTL_SECONDS="604800"
IMAGE_DELIVERY_MAX_BYTES="31457280"
IMAGE_DELIVERY_CLEANUP_INTERVAL_SECONDS="3600"

# 可选模型与超时；取消注释后按方舟账户实际可用值填写。
# ARK_DOUBAO_IMAGE_MODEL_PRO="REPLACE_WITH_AVAILABLE_PRO_MODEL_ID"
# ARK_DOUBAO_IMAGE_MODEL_LITE="REPLACE_WITH_AVAILABLE_LITE_MODEL_ID"
# ARK_DOUBAO_READ_TIMEOUT_SECONDS="300"
