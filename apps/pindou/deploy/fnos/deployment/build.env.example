# 构建/打包参数；与 NAS 运行时 api.env、postgres.env 不同。
# 在 fnos/ 下复制为 deployment/build.env，按实际发布版本修改。
# 本地标签只适用于镜像已在目标 NAS 构建或预加载的情况。
PACKAGE_VERSION=0.1.1
API_IMAGE=pindou-api:0.1.1-fnos-local
WEB_IMAGE=pindou-web:0.1.1-fnos-local
PROXY_IMAGE=pindou-proxy:0.1.1-fnos-local
POSTGRES_IMAGE=postgres:17-alpine
DOCKER_PLATFORM=linux/amd64

# 可选镜像源与依赖源，按网络环境调整。
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.28-alpine
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmmirror.com

# 在 NAS 上构建时，先按部署文档创建受限构建器，再启用这一项。
# DOCKER_BUILDER=pindou-fnos-builder
