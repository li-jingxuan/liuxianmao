# 应用运行环境；默认 development，生产部署请设为 production。
APP_ENV=development

# API 监听地址；0.0.0.0 表示监听所有 IPv4 网卡，浏览器访问时请使用实际 IP。
API_HOST=0.0.0.0

# API 监听端口；默认 3112。
API_PORT=3112

# 是否启用 Uvicorn 代码热重载；默认 true，生产环境应设为 false。
API_RELOAD=true

# PostgreSQL SQLAlchemy 连接串；无安全默认值，必须替换密码且对保留字符进行 URL 编码。
DATABASE_URL=postgresql+psycopg://pindou:replace-with-url-encoded-password@127.0.0.1:5432/pindou

# 管理员签发访问密钥时使用的服务端密钥；无安全默认值，必须替换为高熵随机值。
KEY_ISSUER_API_KEY=replace-with-high-entropy-admin-secret

# API Key 哈希 pepper；无安全默认值，必须替换且不得与其他密码或密钥复用。
API_KEY_HASH_PEPPER=replace-with-different-high-entropy-secret

# 图片增强器；默认 seedream，可选 seedream 或 passthrough，生产环境只能使用 seedream。
IMAGE_ENHANCER=seedream
# 本地 ONNX 能力开关；Seedream 5.0 Solid 正式路径直接验证原生 Alpha。

# 单次上传文件最大字节数；默认 10485760，即 10 MiB。
UPLOAD_MAX_BYTES=10485760

# 上传图片解码后的最大像素数；默认 25000000。
UPLOAD_MAX_PIXELS=25000000

# 转换网格允许的最小边长；默认 8。
MIN_GRID_SIZE=8

# 转换网格允许的最大边长；默认 156。
MAX_GRID_SIZE=156

# 颜色组接口返回的默认 MARD 色组大小；默认 264，转换请求仍需显式提交色组。
DEFAULT_COLOR_SET_SIZE=264

# MARD 色卡文件路径；默认指向仓库 docs/MARD_色卡.json，从 apps/api 启动时可使用此相对路径。
MARD_COLOR_CHART_PATH=../../docs/MARD_色卡.json

# AI 排查图片备份目录；默认位于 API 源码资产目录，从 apps/api 启动时可使用此相对路径。
IMAGE_BACKUP_DIR=src/pindou/assets/images

# 结构化事件日志目录；默认位于仓库根目录 log/，从 apps/api 启动时可使用此相对路径。
EVENT_LOG_DIR=../../log

# 管理员临时交付图片目录；默认位于独立的 API 源码资产目录，不与 AI 排查备份混用。
IMAGE_DELIVERY_DIR=src/pindou/assets/image-deliveries

# 临时交付链接有效期，单位秒；默认 604800，即 7 天，允许范围为 1–30 天。
IMAGE_DELIVERY_TTL_SECONDS=604800

# 单张交付 PNG 最大字节数；默认 15728640，即 15 MiB。
IMAGE_DELIVERY_MAX_BYTES=15728640

# 单张交付 PNG 解码后的最大像素数；默认 50000000。
IMAGE_DELIVERY_MAX_PIXELS=50000000

# 扫描并清理过期交付图片的间隔，单位秒；默认 259200，即 3 天。
IMAGE_DELIVERY_CLEANUP_INTERVAL_SECONDS=259200

# 火山方舟服务端 API Key；无安全默认值，IMAGE_ENHANCER=seedream 时必须替换为有效密钥。
ARK_DOUBAO_API_KEY=replace-with-server-only-ark-key

# 火山方舟 API 基础地址；默认使用北京区域 v3 接口。
ARK_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 中国区 Seedream 5.0 Pro 模型；也可填写绑定同模型的 ep-... 接入点。
ARK_DOUBAO_IMAGE_MODEL_PRO=doubao-seedream-5-0-pro-260628
ARK_DOUBAO_IMAGE_MODEL_LITE=doubao-seedream-5-0-lite-260128

# Seedream 输出尺寸档位；默认 2K。
ARK_DOUBAO_IMAGE_SIZE=2K

# Seedream 响应图片格式；默认且当前仅支持 b64_json。
ARK_DOUBAO_RESPONSE_FORMAT=b64_json

# Seedream 输出是否添加水印；默认 false。
ARK_DOUBAO_WATERMARK=false

# 连接 Seedream 服务的超时，单位秒；默认 5。
ARK_DOUBAO_CONNECT_TIMEOUT_SECONDS=5

# 读取 Seedream 响应的超时，单位秒；默认 90。
ARK_DOUBAO_READ_TIMEOUT_SECONDS=90

# 向 Seedream 写入请求的超时，单位秒；默认 15。
ARK_DOUBAO_WRITE_TIMEOUT_SECONDS=15

# 从 Seedream HTTP 连接池获取连接的超时，单位秒；默认 5。
ARK_DOUBAO_POOL_TIMEOUT_SECONDS=5

# Seedream 请求最大并发数；默认 2，允许范围为 1–32。
ARK_DOUBAO_MAX_CONCURRENCY=2

# Seedream 并发槽位排队超时，单位秒；默认 3。
ARK_DOUBAO_QUEUE_TIMEOUT_SECONDS=3

# Seedream 单次响应体最大字节数；默认 31457280，即 30 MiB。
ARK_DOUBAO_MAX_RESPONSE_BYTES=31457280

# 发送给 Seedream 前允许的图片最长边像素；默认 2048，允许范围为 256–8192。
SEEDREAM_INPUT_MAX_EDGE=2048

# Seedream 返回图片允许的最大像素数；默认 20000000。
SEEDREAM_OUTPUT_MAX_PIXELS=20000000

# 前景蒙版适配器；默认且非测试环境仅支持 onnx。

# ONNX 前景模型变体；默认 u2net，资源或延迟受限时可改为 u2netp。

# ONNX 前景推理最大并发数；默认 1，允许范围为 1–8。

# ONNX 前景推理并发槽位排队超时，单位秒；默认 3。

# ONNX Runtime 单次推理内部线程数；默认 2，允许范围为 1–16。

# ONNX Runtime 空闲线程是否自旋等待；默认 false，可降低空闲 CPU 占用。
