# PostgreSQL
POSTGRES_DB=pindou
POSTGRES_USER=pindou
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Password 必须 URL 编码；主机名固定为 Compose 服务名 postgres
DATABASE_URL=postgresql+psycopg://pindou:replace-with-url-encoded-password@postgres:5432/pindou

# API secrets；两项必须不同，不能复用数据库密码
KEY_ISSUER_API_KEY=replace-with-a-new-random-secret
API_KEY_HASH_PEPPER=replace-with-another-random-secret

# 管理员交付图默认保留 7 天；目录由 Compose 固定挂载，无需在此填写路径。
IMAGE_DELIVERY_TTL_SECONDS=604800
IMAGE_DELIVERY_MAX_BYTES=31457280
IMAGE_DELIVERY_MAX_PIXELS=50000000
IMAGE_DELIVERY_CLEANUP_INTERVAL_SECONDS=3600

# 生产 Solid 必须先由 Seedream 生成动态键色图，再按开关直接 ONNX 或键色抠图。
IMAGE_ENHANCER=seedream
ENABLE_ONNX_MATTING=true
# ARK_DOUBAO_WATERMARK=false
ARK_DOUBAO_API_KEY=replace-with-server-only-ark-key
ARK_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_DOUBAO_IMAGE_MODEL=doubao-seedream-5-0-lite-260128

# Solid 默认使用镜像内置的完整 U²-Net；资源或延迟异常时改为 u2netp 并重启。
FOREGROUND_MODEL_VARIANT=u2net
# FOREGROUND_MODEL_VARIANT=u2netp
# 首版按单并发、双线程控制 NAS 资源。
FOREGROUND_MASK_MAX_CONCURRENCY=1
FOREGROUND_MASK_QUEUE_TIMEOUT_SECONDS=3
FOREGROUND_ONNX_INTRA_OP_THREADS=2
FOREGROUND_ONNX_ALLOW_SPINNING=false

# NAS Web 入口端口
WEB_PORT=3111
# NAS API 入口端口；如无需从宿主机或局域网直接访问 API，可删除 Compose 中的 ports 配置。
API_HOST_PORT=3112

# 国内构建加速；如果镜像不可用，可覆盖为官方地址
NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
NPM_REGISTRY=https://registry.npmmirror.com
# 可选：GitHub 下载受限时改成可信镜像；文件仍必须通过仓库内固定 SHA256。
# U2NET_MODEL_URL=https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2net.onnx

# 使用镜像仓库时填写不可变 tag；本机构建可保持 local
API_IMAGE=pindou-api:local
WEB_IMAGE=pindou-web:local
