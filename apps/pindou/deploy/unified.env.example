# Copy to deploy/.env for unified Web/fnOS management on this NAS.
# JSON double quotes; literal dollars use $$; do not source this file.
# Existing installations must import their original values, never use placeholders.
APP_ENV="production"
API_RELOAD="false"
POSTGRES_DB="pindou"
POSTGRES_USER="pindou"
POSTGRES_PASSWORD="REPLACE_WITH_ORIGINAL_WEB_DB_PASSWORD"
DATABASE_URL="postgresql+psycopg://pindou:REPLACE_WITH_URL_ENCODED_WEB_DB_PASSWORD@postgres:5432/pindou"
KEY_ISSUER_API_KEY="REPLACE_WITH_ORIGINAL_WEB_ADMIN_KEY"
API_KEY_HASH_PEPPER="REPLACE_WITH_ORIGINAL_WEB_PEPPER"

# Shared defaults. Set FNOS_<name> only when an intentional override is needed.
IMAGE_ENHANCER="seedream"
ARK_DOUBAO_API_KEY="REPLACE_WITH_ARK_KEY"
ARK_DOUBAO_MAX_CONCURRENCY="1"
ARK_DOUBAO_READ_TIMEOUT_SECONDS="300"
IMAGE_DELIVERY_TTL_SECONDS="604800"
IMAGE_DELIVERY_MAX_BYTES="31457280"
IMAGE_DELIVERY_CLEANUP_INTERVAL_SECONDS="3600"

# Preserve the existing fnOS database, management key and Pepper independently.
FNOS_POSTGRES_DB="pindou"
FNOS_POSTGRES_USER="pindou"
FNOS_POSTGRES_PASSWORD="REPLACE_WITH_ORIGINAL_FNOS_DB_PASSWORD"
FNOS_DATABASE_URL="postgresql+psycopg://pindou:REPLACE_WITH_URL_ENCODED_FNOS_DB_PASSWORD@postgres:5432/pindou"
FNOS_KEY_ISSUER_API_KEY="REPLACE_WITH_ORIGINAL_FNOS_ADMIN_KEY"
FNOS_API_KEY_HASH_PEPPER="REPLACE_WITH_ORIGINAL_FNOS_PEPPER"
# fnOS 相册外链：相册须为当前登录用户可访问的相册，外链固定 7 天。
FNOS_NAS_ALBUM_BASE_URL="http://host.docker.internal:5666"
FNOS_NAS_ALBUM_ID="25"

NEXT_PUBLIC_API_BASE_URL="http://NAS_IP:3112"
WEB_PORT="3111"
API_HOST_PORT="3112"
POSTGRES_PORT="5433"
API_IMAGE="pindou-api:migrated-20261102"
WEB_IMAGE="pindou-web:migrated-20261102"
FNOS_API_IMAGE="pindou-fnos-api:migrated-20261102"
FNOS_WEB_IMAGE="pindou-fnos-web:migrated-20261102"
FNOS_PROXY_IMAGE="pindou-fnos-proxy:migrated-20261102"
FNOS_PACKAGE_VERSION="0.1.2"
FNOS_DATA_DIR="/vol2/1000/apps/liuxianmao/apps/pindou/deploy/fnos/data"
DOCKER_BUILDER="pindou-managed-builder"
