        "composer": "朴树",
        "sourceBook": "民谣吉他经典歌曲弹唱谱集"
      },
      "sourceImages": [
        "2019052102434570.png",
        "2019052102435058.png",
        "2019052102435715.png"
      ],
      "sourceNotation": {
        "parenthesizedNumberedRests": [
          [
            1,
            4
          ],
          [
            29,
            32
          ]
        ],
        "arrowRanges": "第41–48小节每半小节均为6→3、6→3、4→1、4→1、1→4。禁奏弦随和弦指型。",
        "lastVerse": "第48小节第三行在“啊”后留空，接第49小节。",
        "lastPhrase": "第49末至第50首按连音线分别唱“这、般”。",
        "projectLimits": [
          "双调号及分列署名只在元数据中完整保存。",
          "前奏与间奏的跨小节休止括号不能绘制。",
          "第9、56小节文字可保存，当前排版不绘制；第56小节渐慢无法自动播放。",
          "第29、31小节滑音方向已编码；项目画 S 与斜线，原印谱使用 S 加弧线。",
          "第48小节三遍共用结尾会增加房子括线。",
          "项目自动换行分页，原图行数保存在元数据。"
        ]
      },
      "lyricVerseCount": 3,
      "pfl:sourceLayout": {
        "pageRowMeasureCounts": [
          [
