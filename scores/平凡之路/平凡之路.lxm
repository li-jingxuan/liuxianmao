    "id": "ping-fan-zhi-lu",
    "title": "平凡之路",
    "arranger": "17吉他网",
    "keySignature": "A",
    "meta": {
      "credits": {
        "artist": "朴树",
        "lyricists": [
          "朴树",
          "韩寒"
